{
  "meta": {
    "product": "MONAD",
    "scope": "standalone product identity",
    "phase": "1.2",
    "version": "1.2.0",
    "locked": "2026-11-05",
    "source": "brand v4 traced mark + Inter outlines",
    "colourSpace": "sRGB",
    "accessibility": {
      "standard": "WCAG 2.1 AA",
      "rule": "accent is a surface/graphic colour; accentText is the only amber approved for small text",
      "minRatioSmallText": 4.5
    },
    "gapFilled": [
      "fontWeights",
      "lineHeights",
      "borders",
      "shadows",
      "breakpoints",
      "zIndex",
      "focusRing",
      "spacingTokens"
    ]
  },
  "color": {
    "dark": {
      "bg": "#17181A",
      "surface": "#1E1F22",
      "surface2": "#26282C",
      "ink": "#EDE4D4",
      "muted": "#A29682",
      "accent": "#C8832A",
      "accentStrong": "#E0A24B",
      "line": "rgba(237,228,212,0.10)",
      "positive": "#7FA87F",
      "negative": "#C4705F",
      "warning": "#C9A227",
      "accentText": "#E0A24B",
      "lineStrong": "rgba(237,228,212,0.22)",
      "focus": "#E0A24B",
      "overlay": "rgba(9,10,11,0.62)",
      "accentSoft": "rgba(200,131,42,0.14)"
    },
    "light": {
      "bg": "#F5F1E8",
      "surface": "#FFFFFF",
      "surface2": "#EDE7DA",
      "ink": "#1A1917",
      "muted": "#6F6656",
      "accent": "#A9661E",
      "accentStrong": "#C8832A",
      "line": "rgba(26,25,23,0.10)",
      "positive": "#4F7A52",
      "negative": "#A14A3C",
      "warning": "#8A6D12",
      "accentText": "#8C5315",
      "accentStrongText": "#9A5B18",
      "lineStrong": "rgba(26,25,23,0.22)",
      "focus": "#8C5315",
      "overlay": "rgba(26,25,23,0.38)",
      "accentSoft": "rgba(169,102,30,0.10)"
    }
  },
  "type": {
    "family": {
      "fa": "Vazirmatn",
      "en": "Inter"
    },
    "scale": {
      "caption": 12,
      "body": 14,
      "lead": 16,
      "title": 20,
      "display": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "numeral": "tabular-nums",
    "lineHeight": {
      "tight": 1.25,
      "base": 1.6,
      "loose": 1.8
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "control": 12,
    "card": 16,
    "sheet": 20,
    "modal": 24,
    "pill": 999
  },
  "motion": {
    "micro": 160,
    "transition": 220,
    "sheet": 280,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "respectReducedMotion": true
  },
  "elevation": {
    "none": "none",
    "hairline": "0 0 0 1px rgba(237,228,212,.10)"
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "leading": {
    "tight": 1.25,
    "ui": 1.45,
    "base": 1.75,
    "loose": 2.0
  },
  "border": {
    "hairline": "1px solid var(--m-color-line)",
    "strong": "1px solid var(--m-color-line-strong)",
    "focus": "2px solid var(--m-color-focus)"
  },
  "shadow": {
    "none": "none",
    "card": "0 1px 2px rgba(0,0,0,.18), 0 8px 24px -18px rgba(0,0,0,.55)",
    "raised": "0 2px 6px rgba(0,0,0,.22), 0 18px 40px -24px rgba(0,0,0,.65)",
    "sheet": "0 -8px 40px -12px rgba(0,0,0,.55)"
  },
  "breakpoint": {
    "sm": "380px",
    "md": "600px",
    "lg": "900px",
    "xl": "1200px"
  },
  "z": {
    "base": 0,
    "raised": 10,
    "sticky": 20,
    "nav": 30,
    "sheet": 40,
    "modal": 50,
    "toast": 60,
    "tooltip": 70
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "colorDark": "#E0A24B",
    "colorLight": "#8C5315"
  },
  "spaceNamed": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64
  }
}